PORT=3001

# https://resend.com/api-keys
RESEND_API_KEY=

# Must be onboarding@resend.dev until you verify a sending domain in Resend,
# then switch to an address on your own domain (e.g. no-reply@deewandevelopment.com).
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where contact form submissions get delivered.
CONTACT_RECIPIENT_EMAIL=project@deewandevelopment.com

# Frontend origin allowed to call this API (comma-separated for multiple).
FRONTEND_ORIGIN=http://localhost:5173
